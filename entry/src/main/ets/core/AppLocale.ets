  static text(source: string): string {
    return AppLocale.resolve(AppLocale.currentLanguage(), source);
  }

  static isEnglish(): boolean {
    return AppLanguage.normalized(AppLocale.currentLanguage()) === AppLanguage.ENGLISH;
  }

  static currentLanguage(): string {
    let language: string = AppLanguage.SYSTEM;
    const stored: string | undefined = AppStorage.get<string>('appDisplayLanguage');
    if (stored !== undefined) return AppLanguage.normalized(stored);
    try { language = i18n.System.getAppPreferredLanguage(); } catch (_) {}
    return AppLanguage.normalized(language);
  }

  static dateTime(language: string, timestamp: number): string {
    const date: Date = new Date(timestamp);
    const two: (value: number) => string = (value: number): string => value < 10 ? `0${value}` : `${value}`;
    if (AppLanguage.normalized(language) === AppLanguage.ENGLISH) {
      return `${date.getFullYear()}-${two(date.getMonth() + 1)}-${two(date.getDate())} ${two(date.getHours())}:${two(date.getMinutes())}`;
    }
    return `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日 ${two(date.getHours())}:${two(date.getMinutes())}`;
  }

  static currentDateTime(timestamp: number): string {
    let language: string = AppLanguage.SYSTEM;
    try { language = i18n.System.getAppPreferredLanguage(); } catch (_) {}
    return AppLocale.dateTime(language, timestamp);
  }

  static dateShort(timestamp: number): string {
    const date: Date = new Date(timestamp);
    if (Number.isNaN(date.getTime())) return '';
    let language: string = AppLanguage.SYSTEM;
    try { language = i18n.System.getAppPreferredLanguage(); } catch (_) {}
    return AppLanguage.normalized(language) === AppLanguage.ENGLISH
      ? `${date.toLocaleString('en-US', { month: 'short' })} ${date.getDate()}`
      : `${date.getMonth() + 1}月${date.getDate()}日`;
  }

  static monthDay(month: number, day: number): string {
    let language: string = AppLanguage.SYSTEM;
    try { language = i18n.System.getAppPreferredLanguage(); } catch (_) {}
    if (AppLanguage.normalized(language) !== AppLanguage.ENGLISH) return `${month}月${day}日`;
    const date: Date = new Date(2026, month - 1, day);
    return `${date.toLocaleString('en-US', { month: 'short' })} ${day}`;
  }

  static monthDayWithYear(timestamp: number): string {
    const date: Date = new Date(timestamp);
    if (Number.isNaN(date.getTime())) return '';
    if (!AppLocale.isEnglish()) return `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日`;
    return `${date.toLocaleString('en-US', { month: 'short' })} ${date.getDate()}, ${date.getFullYear()}`;
  }

  static serverError(code: number): string {
    return AppLocale.isEnglish() ? `Server returned ${code}. Please try again later.` : `服务器返回 ${code}，请稍后重试。`;
  }

  static bookCreditsInsufficient(need: string, have: string): string {
    return AppLocale.isEnglish()
      ? `Insufficient credits: a revision costs ${need}; you have ${have}.`
      : `算力不足：改一次要 ${need} 算力，你现在有 ${have}。`;
  }

  static bookWritingCreditsInsufficient(need: string, have: string): string {
    return AppLocale.bookWritingCreditsInsufficientForLanguage(AppLocale.currentLanguage(), need, have);
  }

  static bookWritingCreditsInsufficientForLanguage(language: string, need: string, have: string): string {
    return AppLanguage.normalized(language) === AppLanguage.ENGLISH
      ? `Insufficient credits: writing a book costs ${need}; you have ${have}.`
      : `算力不足：写一本书要 ${need} 算力，你现在有 ${have}。`;
  }

  static count(value: number, chineseUnit: string, englishUnit: string): string {
    let language: string = AppLanguage.SYSTEM;
    try { language = i18n.System.getAppPreferredLanguage(); } catch (_) {}
    return AppLanguage.normalized(language) === AppLanguage.ENGLISH
      ? `${value} ${englishUnit}`
      : `${value} ${chineseUnit}`;
  }
}
